# Private server-side credentials only; never put keys in browser code.
METERLESS_RUNTIME_TOKEN=
METERLESS_MODEL=
METERLESS_BASE_URL=
METERLESS_APP_ID=recallops
# Set this to the context allocated by the actual runtime.
METERLESS_CONTEXT_TOKENS=32768
ZETARIS_REST_URL=
ZETARIS_API_KEY=
ZETARIS_ORG_ID=
ZETARIS_VIEW_MAP={}
# Optional separately registered view with the reviewed FDA scope column contract.
ZETARIS_VIEW_REVIEWED_SCOPE=
# Optional: integer 1..300000 ms; unset/blank keeps 30000. Recommend 120000 for local cold starts.
# ZETARIS_TIMEOUT_MS=120000
# Explicitly labelled replay can run without credentials; live mode must pass sponsor gates.
RECALLOPS_DATA_MODE=replay
RECALLOPS_STATE_DIR=./state
# Remains false until the chosen account and inference spending are authorized.
RECALLOPS_ALLOW_INFERENCE=false
